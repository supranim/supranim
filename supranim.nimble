# Package

version       = "0.1.10"
author        = "OpenPeeps"
description   = "A full-featured web framework for Nim"
license       = "LGPL-3.0-or-later"
srcDir        = "src"

# Core dependencies
requires "nim >= 2.2.10"
requires "threading >= 0.2.1"
requires "semver >= 1.2.3"
requires "kapsis >= 0.4.0"

requires "powpow >= 0.1.9"
requires "ozark >= 0.1.6"
requires "emitter >= 0.2.1[powpow]"
requires "nimcypher >= 0.1.0"
requires "openparser >= 0.2.0"
requires "mimedb >= 0.1.1"
requires "checksums >= 0.2.2"
requires "flysystem >= 0.1.0"
requires "twofa >= 0.1.0"


